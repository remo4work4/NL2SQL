# 阿里云百炼 API Key（必填，用于 Qwen3 调用，冒烟测试前填入）
DASHSCOPE_API_KEY=

# 模型型号（可选，默认 qwen3.8-max）
# 备选：qwen-max（稳定别名，自动跟随最新旗舰）、qwen-plus（低成本档）
LLM_MODEL=qwen3.8-max

# ---- RAG 语义检索（Phase 6：向量+BM25 双路 → RRF 融合 → 交叉编码器重排）----
# RAG_ENABLED=false   # 关闭检索，全量注入（改造前行为）
# RAG_CANDIDATE_K=10  # 向量/BM25 各路候选数（RRF 融合前）
# RAG_TOP_K=8         # RRF 融合后进入交叉编码器重排的候选数
# RAG_MAX_TABLES=6    # 注入上限（含 JOIN 闭包）
# RAG_SCORE_THRESHOLD=0.25  # 向量路余弦相似度阈值
# RAG_BM25_ENABLED=false    # 关闭 BM25 词法路
# RAG_RERANK_ENABLED=false  # 关闭交叉编码器重排（回退 RRF 排序）
# RAG_RERANK_THRESHOLD=0.0  # 重排分数下限
# BGE_MODEL=BAAI/bge-m3     # 本地目录缺失时按此 ID 下载
# BGE_MODEL_DIR=models/bge-m3  # 本地 BGE 模型目录
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3  # 重排序交叉编码器
# RERANKER_MODEL_DIR=models/bge-reranker-v2-m3
# CHROMA_DIR=data/chroma       # Chroma 持久化目录
# HF_ENDPOINT=https://hf-mirror.com  # 模型下载镜像（国内直连 HF 不通时用）

# ---- Phase 8 多进程：共享限流 ----
# REDIS_URL=redis://127.0.0.1:6379/0  # Redis 令牌桶后端；为空时用 PG 后端
# LLM_RATE_PER_SECOND=2.0  # 令牌桶补充速率（全局 tokens/s）
# TORCH_THREADS=4          # 每 worker torch 推理线程数（多 worker 防 CPU 打满）

# ---- Phase 9 多实例：PostgreSQL + 服务化 ----
# PG_DSN=postgresql://nl2sql:nl2sql@127.0.0.1:5433/nl2sql
# PG_BUSINESS_DSN=postgresql://nl2sql_ro:nl2sql_ro@127.0.0.1:5433/nl2sql
# CHROMA_MODE=server       # embedded | server（多实例用 server）
# CHROMA_HOST=127.0.0.1
# CHROMA_PORT=8002
# MODEL_SERVICE_URL=http://127.0.0.1:8004  # 模型服务（空 = 进程内加载）
# SCHEMA_CACHE_TTL=10      # schema 摘要/BM25 缓存秒数（PG 无文件 mtime，TTL 收敛）
